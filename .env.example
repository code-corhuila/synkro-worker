# Configuration of synkro-worker. No real values belong in this file or in any
# committed .env file. Invalid values stop the Worker at startup with an error
# that names the setting; they never fall back to a default.

# Required. The Worker's SERVICE token, issued by synkro-auth-api, with the
# permissions products:read, stock-alerts:read and stock-alerts:write. In
# deploy/compose.yml it is injected from WORKER_SERVICE_TOKEN.
SERVICE_TOKEN=

# Origin of synkro-products-api (http or https, no credentials, no query).
PRODUCTS_API_URL=http://synkro-products-api:8080

# How often the low-stock job runs (>= 1s).
LOW_STOCK_EVERY=15m
# Alerts open for products with stock <= this value (integer >= 0).
LOW_STOCK_THRESHOLD=5
# TOTAL reconciliation elements per run, 1..100 (also the API's page limit),
# shared by both phases: ceil(n/2) to open and floor(n/2) to resolve; with 1,
# the open and resolve phases alternate between runs. A quota is not lent to
# the other phase. It counts list elements, not HTTP requests: evaluating an
# element can add a product read and a mutation, bounded by HTTP_ATTEMPTS and
# RUN_TIMEOUT.
BATCH_SIZE=100
# Cap, 1..100, on list reads per phase and per run. Page limit is fixed at
# ceil(phase quota / this cap). Reserve a full page before each read, including
# short responses; unused admission slots are not reclaimed in the run.
# This cap never multiplies the BATCH_SIZE total.
LOW_STOCK_MAX_PAGES=5
# Deadline of one run. Cooperative: it stops the job's HTTP calls, nothing else.
RUN_TIMEOUT=2m
# Timeout of one HTTP attempt; must not exceed RUN_TIMEOUT.
HTTP_TIMEOUT=5s
# Attempts per call, first one included, 1..10. Only network errors, 429 and
# 5xx are retried, with exponential backoff and full jitter.
HTTP_ATTEMPTS=3
